# GitHub OAuth App の設定
#
# 取得手順:
#   1. https://github.com/settings/developers → OAuth Apps → New OAuth App
#   2. 以下を入力:
#        Application name          : meeTai
#        Homepage URL              : https://YOUR_DOMAIN
#        Authorization callback URL: https://YOUR_DOMAIN/oauth2callback
#   3. 登録後に表示される Client ID と Client Secret を下に貼る
#
# cookie_secret の生成:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

[auth]
redirect_uri   = "https://YOUR_DOMAIN/oauth2callback"
cookie_secret  = "REPLACE_WITH_RANDOM_HEX_STRING"

[auth.github]
client_id     = "YOUR_GITHUB_CLIENT_ID"
client_secret = "YOUR_GITHUB_CLIENT_SECRET"
