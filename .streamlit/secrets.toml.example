# Google OAuth の設定
#
# 取得手順:
#   1. https://console.cloud.google.com/ → APIとサービス → 認証情報
#   2. 「認証情報を作成」→「OAuth 2.0 クライアント ID」→「ウェブアプリケーション」
#   3. 承認済みのリダイレクト URI に追加:
#        https://YOUR_DOMAIN/oauth2callback
#   4. 表示される クライアントID と クライアントシークレット を下に貼る
#
# cookie_secret の生成:
#   python3 -c "import secrets; print(secrets.token_hex(32))"

[auth]
redirect_uri   = "https://YOUR_DOMAIN/oauth2callback"
cookie_secret  = "REPLACE_WITH_RANDOM_HEX_STRING"

[auth.google]
client_id             = "YOUR_GOOGLE_CLIENT_ID"
client_secret         = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url   = "https://accounts.google.com/.well-known/openid-configuration"
