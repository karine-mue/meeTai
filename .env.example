# --- Google Gemini ---
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-opus-4-6

# --- OpenAI GPT ---
OPENAI_API_KEY=your_openai_api_key
# GPT_MODEL > OPENAI_MODEL > 既定値(gpt-5.4) の優先順で採用される
OPENAI_MODEL=gpt-5.4
# GPT_MODEL=

# reasoning model のみ有効: minimal / low / medium / high（未指定・不正値は high）
# GPT_REASONING_EFFORT=high

# reasoning model では reasoning token も max_output_tokens に含まれるため、
# 小さすぎる値は本文が空のまま incomplete になる。
#
# 注意: ここに 16384 未満を明示指定しても、reasoning model では
# openai_gpt.py の REASONING_MIN_OUTPUT_TOKENS まで引き上げられる。
# この数値は測定値ではなく「これ未満はほぼ確実に壊れる」側の下限として
# 置いた heuristic（意図と根拠は同ファイルのコメント参照）。
# 下限自体を変えたい場合はその定数を編集する。
# GPT_MAX_TOKENS=16384

# 送信可否がモデルごとに変わる parameter（reasoning / temperature）の判定は
# openai_gpt.py の _CAPABILITY_PROFILES に集約されている。
# 未登録のモデル名は fail-closed（必須 field のみ送信）で扱われる。

# --- 認証（Googleログイン 許可リスト） ---
# カンマ区切りで複数指定可（Googleアカウントのプライマリメールを指定する）
ALLOWED_EMAILS=your@email.com

# --- Storage ---
CHECKPOINT_DB=checkpoints.sqlite
APP_DB=meetai_app.sqlite

# --- Session archive ---
# created_at / updated_at / 年月検索で使うタイムゾーン
APP_TIMEZONE=Asia/Tokyo

# user: 自分のメールで作ったセッションだけ見える（安全側デフォルト）
# shared: SESSION_ARCHIVE_SHARED_EMAILS に含まれるメール同士で相互に見える
# all: 許可済みアカウント全員が全セッションを見える（個人運用向け）
SESSION_ARCHIVE_SCOPE=user
SESSION_ARCHIVE_SHARED_EMAILS=

# --- Server ---
# backend / frontend ともに 127.0.0.1 固定（外部に露出しない）
# 外部公開は Caddy が 443 で受けて localhost へ転送する
BACKEND_HOST=127.0.0.1
PORT=8008
