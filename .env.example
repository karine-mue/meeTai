# --- Google Gemini ---
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-opus-4-6

# --- OpenAI GPT ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# --- 認証（Google OIDC 許可リスト） ---
# カンマ区切りで複数指定可
ALLOWED_EMAILS=your@email.com

# --- Storage ---
CHECKPOINT_DB=checkpoints.sqlite
APP_DB=meetai_app.sqlite

# --- Session archive ---
# created_at / updated_at / 年月検索で使うタイムゾーン
APP_TIMEZONE=Asia/Tokyo

# user: 自分のメールで作ったセッションだけ見える（安全側デフォルト）
# shared: SESSION_ARCHIVE_SHARED_EMAILS に含まれるメール同士で相互に見える
# all: 許可済みアカウント全員が全セッションを見える（個人運用向け）
SESSION_ARCHIVE_SCOPE=user
SESSION_ARCHIVE_SHARED_EMAILS=

# --- Server ---
# backend / frontend ともに 127.0.0.1 固定（外部に露出しない）
# 外部公開は Caddy が 443 で受けて localhost へ転送する
BACKEND_HOST=127.0.0.1
PORT=8008
