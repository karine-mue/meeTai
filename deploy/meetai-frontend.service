[Unit]
Description=meeTai Frontend (Streamlit)
After=network.target meetai-backend.service

[Service]
Type=simple
User=SERVICE_USER
WorkingDirectory=APP_DIR
EnvironmentFile=APP_DIR/.env
ExecStart=APP_DIR/.venv/bin/streamlit run APP_DIR/frontend.py \
    --server.port 8501 \
    --server.address 127.0.0.1 \
    --server.headless true \
    --server.enableCORS false
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
